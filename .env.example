# ─── Service ──────────────────────────────────────────────────────────────
RAG_PORT=8090
RAG_LOG_LEVEL=INFO
# Clones, SQLite (repos/files/jobs) and the enrichment cache are written here.
RAG_DATA_DIR=data

# ─── Milvus ───────────────────────────────────────────────────────────────
# Brought up by `docker compose -f infra/docker-compose.yml up -d`.
RAG_MILVUS_URI=http://localhost:19530
RAG_MILVUS_COLLECTION=code_chunks

# ─── Embedding ────────────────────────────────────────────────────────────
# local  → BGE-M3 via sentence-transformers (multilingual: a question in your language
#          against English code). ~2.2 GB is downloaded on the first run.
# openai → text-embedding-3-large (dimensions=1024). Needs OPENAI_API_KEY.
RAG_EMBEDDING_BACKEND=local
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIM=1024
RAG_EMBEDDING_BATCH_SIZE=32
# "mps" is picked automatically on Apple M-series; force it with cpu|mps|cuda.
# RAG_EMBEDDING_DEVICE=mps

# ─── Retrieval ────────────────────────────────────────────────────────────
# auto: symbol-shaped query (camelCase, snake_case, a.b.c) → BM25; plain sentence → RAG_PROSE_MODE.
RAG_SEARCH_MODE=auto
# Measured (evals/results/): dense beat hybrid on MRR (0.678 vs 0.604), recall unchanged.
RAG_PROSE_MODE=dense
RAG_RRF_K=60
RAG_TOP_K=8
# How many candidates reach the reranker. Handing it 8 only re-orders them and cannot
# touch recall — use at least 40.
RAG_CANDIDATES=40
# Measured: bge-reranker-v2-m3 lowered both recall AND MRR on this corpus, and pushed p50 to 2-4 s.
# If you turn it on, measure it on your own repo first with `rag eval --rerank`.
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ─── Chunking ─────────────────────────────────────────────────────────────
# A chunk ≈ a code unit (function/class/method). 2000 bytes ≈ 500 tokens; anything larger
# gets embedded as an "average" of several things.
RAG_CHUNK_MAX_BYTES=2000
RAG_CHUNK_MIN_BYTES=200
RAG_MAX_FILE_BYTES=512000

# ─── LLM (/ask and optional chunk descriptions) ───────────────────────────
# auto | anthropic | openai | ollama
# auto: Claude if ANTHROPIC_API_KEY is set, else OpenAI if OPENAI_API_KEY is set, else
# local Ollama (default model qwen3.5:9b → `ollama pull qwen3.5:9b`). Retrieval works with no LLM.
RAG_LLM_PROVIDER=auto
# RAG_LLM_MODEL=qwen3.5:9b            # ollama: qwen3.5:4b (3.4 GB, weaker machine) · anthropic: claude-opus-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# An OpenAI-compatible local server (vLLM, LM Studio, llama.cpp): RAG_LLM_PROVIDER=openai + a base URL.
# RAG_OPENAI_BASE_URL=http://localhost:8000/v1
RAG_OLLAMA_HOST=http://localhost:11434
# Ollama context window: an 8-chunk prompt is ~6k tokens, and Ollama's 4k default truncates it silently.
RAG_OLLAMA_NUM_CTX=16384
# Generates a description for every chunk and adds it to the index (Anthropic's "contextual
# retrieval"). Expensive; measure with `rag eval` first.
RAG_ENRICH_ENABLED=false
# The language those descriptions are written in. The measured gain comes from adding prose
# in the language people ask questions in, so set it to match your question traffic
# ("English", "Turkish", "Deutsch", …). Non-Latin alphabets are rejected as a safety net.
RAG_ENRICH_LANGUAGE=English

# ─── Azure DevOps ─────────────────────────────────────────────────────────
# PAT scope: Code (Read). Organization: https://dev.azure.com/<org>
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-org
AZURE_DEVOPS_PAT=

# ─── GitHub (optional) ────────────────────────────────────────────────────
# Public repos work without a token; private ones need a fine-grained PAT (Contents: Read).
GITHUB_TOKEN=

# ─── MCP (connecting agents) ──────────────────────────────────────────────
# The MCP endpoint for agents: http://<host>:8090/mcp (streamable HTTP).
#   claude mcp add --transport http milvus-rag http://localhost:8090/mcp
# As a defence against DNS rebinding the endpoint accepts only localhost by default;
# add the host (including the port) here if you will connect from another address.
RAG_MCP_ALLOWED_HOSTS=

# ─── Refreshing ───────────────────────────────────────────────────────────
# Azure Service Hook → "Code pushed" → POST http://<host>:8090/webhooks/azure/push
#   (the X-RAG-Webhook-Secret header, or the Basic auth password, is this value)
# GitHub → Settings → Webhooks → POST http://<host>:8090/webhooks/github/push
#   (content type: application/json, the Secret field is this value; HMAC-SHA256 is verified)
RAG_WEBHOOK_SECRET=change-me
# If there is no webhook, or one is missed: compare the branch head every N seconds (0 = off).
RAG_POLL_INTERVAL_SECONDS=300
