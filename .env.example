# ─── Servis ───────────────────────────────────────────────────────────────
RAG_PORT=8090
RAG_LOG_LEVEL=INFO
# Klonlar, SQLite (repos/files/jobs) ve enrichment cache buraya yazılır.
RAG_DATA_DIR=data

# ─── Milvus ───────────────────────────────────────────────────────────────
# `docker compose -f infra/docker-compose.yml up -d` ile ayağa kalkar.
RAG_MILVUS_URI=http://localhost:19530
RAG_MILVUS_COLLECTION=code_chunks

# ─── Embedding ────────────────────────────────────────────────────────────
# local  → sentence-transformers ile BGE-M3 (çok dilli: Türkçe soru + İngilizce kod). İlk çalıştırmada ~2.2 GB iner.
# openai → text-embedding-3-large (dimensions=1024). OPENAI_API_KEY gerekir.
RAG_EMBEDDING_BACKEND=local
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIM=1024
RAG_EMBEDDING_BATCH_SIZE=32
# Apple M-serisinde otomatik "mps" seçilir; zorlamak için cpu|mps|cuda.
# RAG_EMBEDDING_DEVICE=mps

# ─── Retrieval ────────────────────────────────────────────────────────────
# auto: sembol biçimli sorgu (camelCase, snake_case, a.b.c) → BM25; düz cümle → RAG_PROSE_MODE.
RAG_SEARCH_MODE=auto
# Ölçüldü (evals/results/): dense MRR'da hybrid'i geçti (0.678 vs 0.604), recall aynı.
RAG_PROSE_MODE=dense
RAG_RRF_K=60
RAG_TOP_K=8
# Reranker'a giden aday sayısı. 8 aday vermek sadece sıralar, recall'a dokunamaz — en az 40.
RAG_CANDIDATES=40
# Ölçüldü: bge-reranker-v2-m3 bu korpusta recall VE MRR düşürdü, p50'yi 2-4 sn yaptı.
# Açacaksan önce `rag eval --rerank` ile kendi reponda ölç.
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ─── Chunking ─────────────────────────────────────────────────────────────
# Chunk ≈ kod birimi (fonksiyon/sınıf/metod). 2000 byte ≈ 500 token; daha büyüğü "ortalama" embed olur.
RAG_CHUNK_MAX_BYTES=2000
RAG_CHUNK_MIN_BYTES=200
RAG_MAX_FILE_BYTES=512000

# ─── LLM (/ask ve isteğe bağlı chunk açıklamaları) ─────────────────────────
# anthropic | openai | ollama
RAG_LLM_PROVIDER=anthropic
# RAG_LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RAG_OLLAMA_HOST=http://localhost:11434
# Türkçe chunk açıklaması üretip index'e ekler (Anthropic "contextual retrieval"). Pahalı; önce eval ile ölç.
RAG_ENRICH_ENABLED=false

# ─── Azure DevOps ─────────────────────────────────────────────────────────
# PAT kapsamı: Code (Read). Organizasyon: https://dev.azure.com/<org>
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-org
AZURE_DEVOPS_PAT=

# ─── GitHub (isteğe bağlı) ────────────────────────────────────────────────
# Public repolar tokensız çalışır; private için fine-grained PAT (Contents: Read).
GITHUB_TOKEN=

# ─── Tazeleme ─────────────────────────────────────────────────────────────
# Azure Service Hook → "Code pushed" → POST http://<host>:8090/webhooks/azure/push
#   (Header X-RAG-Webhook-Secret ya da Basic auth şifresi bu değer)
# GitHub → Settings → Webhooks → POST http://<host>:8090/webhooks/github/push
#   (content type: application/json, Secret alanı bu değer; HMAC-SHA256 doğrulanır)
RAG_WEBHOOK_SECRET=change-me
# Webhook yoksa/kaçarsa: her N saniyede bir Azure'daki branch head'i ile karşılaştır (0 = kapalı).
RAG_POLL_INTERVAL_SECONDS=300
